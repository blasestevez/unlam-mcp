# Opcional: lo normal es usar `unlam-mcp login`. Sólo si corrés desde una copia local
# y no querés usar el gestor de credenciales, copiá esto a .env y completalo.
MIEL_USUARIO=
MIEL_CLAVE=

# Opcionales
# Carpeta de descargas (por defecto ~/MIeL)
MIEL_CARPETA=
# Segundos mínimos entre requests a MIeL
MIEL_INTERVALO_MINIMO=0.5
# Segundos que se reutiliza una página ya consultada
MIEL_CACHE_TTL=120
